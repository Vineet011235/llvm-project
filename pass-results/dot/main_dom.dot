digraph DOMTree {
  rankdir=TB;
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=12];
  edge [color="#2E86AB", penwidth=2, arrowsize=0.8];

  "BB_3" [fillcolor="#4ECDC4", fontcolor="white", shape=box];
