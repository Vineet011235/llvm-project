digraph CFG {
  node [shape=box, fontname="monospace", style=filled];
  edge [penwidth=1.5];

  BB_3 [label="BB_3\l2 instructions\l  %puts = tail call i32 @puts(ptr nonnull dereferenceable(1)...\l  br label %for.body, !dbg !43\l", fillcolor="lightblue", fontcolor="black"];
  BB_4 [label="BB_4\l1 instructions\l  ret i32 0, !dbg !44\l", fillcolor="lightgreen", fontcolor="black"];
  BB_5 [label="BB_5\l5 instructions\l  %indvars.iv = phi i64 [ 0, %entry ], [ %indvars.iv.next, %...\l  %arrayidx = getelementptr inbounds nuw i32, ptr @__const.m...\l...\l  %cmp.i = icmp samesign ult i64 %indvars.iv, 2, !dbg !62\l  br i1 %cmp.i, label %fibonacci.exit, label %for.body.i, !d...\l", fillcolor="lightyellow", fontcolor="black"];
  BB_6 [label="BB_6\l7 instructions\l  %i.09.i = phi i32 [ %inc.i, %for.body.i ], [ 2, %for.body ...\l  %curr.08.i = phi i32 [ %add.i, %for.body.i ], [ 1, %for.bo...\l...\l  %exitcond.not.i = icmp eq i32 %i.09.i, %0, !dbg !69\l  br i1 %exitcond.not.i, label %fibonacci.exit, label %for.b...\l", fillcolor="lightyellow", fontcolor="black"];
  BB_7 [label="BB_7\l5 instructions\l  %retval.0.i = phi i32 [ %0, %for.body ], [ %add.i, %for.bo...\l  %call2 = tail call i32 (ptr, ...) @printf(ptr noundef nonn...\l...\l  %exitcond.not = icmp eq i64 %indvars.iv.next, 6, !dbg !78\l  br i1 %exitcond.not, label %for.cond.cleanup, label %for.b...\l", fillcolor="lightyellow", fontcolor="black"];

  BB_3 -> BB_5 [color="blue"];
  BB_5 -> BB_7 [color="darkgreen", label="true"];
  BB_5 -> BB_6 [color="red", label="false"];
  BB_6 -> BB_7 [color="darkgreen", label="true"];
  BB_6 -> BB_6 [color="red", label="false"];
  BB_7 -> BB_4 [color="darkgreen", label="true"];
  BB_7 -> BB_5 [color="red", label="false"];
}
